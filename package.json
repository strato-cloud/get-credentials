{
  "name": "strato-cloud-get-credentials",
  "version": "1.0.3",
  "description": "GitHub Action to get ephemeral workload JIT credentials from Strato Cloud",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "package": "ncc build src/index.ts -o dist --source-map --license licenses.txt",
    "package:get-token": "ncc build src/get-token.ts -o get-token/dist --source-map --license licenses.txt",
    "package:all": "npm run package && npm run package:get-token",
    "test": "jest",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts"
  },
  "keywords": [
    "github-action",
    "strato-cloud",
    "credentials",
    "jit",
    "aws",
    "azure",
    "gcp"
  ],
  "author": "Strato Cloud",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^1.10.1",
    "@actions/github": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "@vercel/ncc": "^0.38.1",
    "eslint": "^9.39.2",
    "prettier": "^3.1.0",
    "typescript": "^5.3.2"
  }
}
